# Server
PORT=3456

# Writable dir for kill-switch.json + heartbeats/ (default: ./data)
# DAN_DATA_DIR=./data

# If set, POST /signals /kill-switch /heartbeats and job gates require:
#   Authorization: Bearer <token>
# DAN_CONTROL_TOKEN=

# Sentry intake adapter (HMAC-SHA256 on sentry-hook-signature).
# Unset = verification skipped with a console warning. Local only.
# SENTRY_WEBHOOK_SECRET=

# Optional Slack incoming webhook. Unset = notifications skipped.
# SLACK_WEBHOOK_URL=
