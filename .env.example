# Server
PORT=3456

# Listen address. Default 127.0.0.1.
# A non-loopback value refuses to start when DAN_CONTROL_TOKEN is unset.
# A non-loopback value also refuses to start when DAN_ALLOW_UNSIGNED_WEBHOOKS=1.
# DAN_LOCAL_SHOWCASE does not override either refusal.
# DAN_HOST=127.0.0.1

# Writable dir for kill-switch.json, its audit log, and heartbeats/ (default: ./data).
# Jobs live in memory and are lost on restart.
# An empty value is an error. The server prints the resolved directory on start.
# dan ks status prints it too.
# DAN_DATA_DIR=./data

# Set DAN_CONTROL_TOKEN for anything beyond a laptop demo.
# DAN_LOCAL_SHOWCASE=1 and DAN_ALLOW_UNSIGNED_WEBHOOKS=1 are for local demos only.
#
# An empty DAN_CONTROL_TOKEN counts as unset.
# With DAN_CONTROL_TOKEN unset, control routes return 503 and change nothing,
# unless DAN_LOCAL_SHOWCASE is exactly 1.
# POST /trigger and POST /webhook/trigger both use this rule.
# When the token is set, send Authorization: Bearer and the token.
# A missing or wrong bearer is 401.
# DAN_CONTROL_TOKEN=

# Local demos only. Exactly 1 leaves control routes open when DAN_CONTROL_TOKEN
# is unset, and the server logs one warning at start. In that mode every
# control route, GET included, requires a Host header of localhost:<port>
# or 127.0.0.1:<port>. It does not write a kill-switch file. Only `dan init`
# writes that file, and only when none exists.
# DAN_LOCAL_SHOWCASE=

# Sentry intake adapter (HMAC-SHA256 on sentry-hook-signature).
# An empty SENTRY_WEBHOOK_SECRET counts as unset.
# Unset: POST /webhook/sentry returns 503 and ingests nothing.
# SENTRY_WEBHOOK_SECRET=

# Local demos only. Exactly 1 accepts unsigned Sentry posts when
# SENTRY_WEBHOOK_SECRET is unset. That path logs one warning.
# A non-loopback DAN_HOST with this flag set to 1 is refused at start.
# DAN_ALLOW_UNSIGNED_WEBHOOKS=

# Optional Slack incoming webhook. Unset = notifications skipped.
# SLACK_WEBHOOK_URL=
